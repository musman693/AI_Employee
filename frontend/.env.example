# Server-side URL used by the Next.js backend proxy.
BACKEND_URL=http://127.0.0.1:8000
CRM_BACKEND_URL=http://127.0.0.1:8001
COMMUNICATION_BACKEND_URL=http://127.0.0.1:8002
AUTH_BACKEND_URL=http://127.0.0.1:3001

# Optional browser override. Leave empty to use the same-origin /api/backend proxy.
NEXT_PUBLIC_API_GATEWAY_URL=
NEXTAUTH_SECRET=replace-this-with-a-secure-random-value
NEXT_PUBLIC_NEXTAUTH_URL=http://localhost:3000
# Add any third-party keys used by the frontend (analytics, Sentry, etc.)
