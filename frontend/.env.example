# Server-side URL used by the Next.js backend proxy.
BACKEND_URL=http://127.0.0.1:8000

# Frontend runtime environment
NEXT_PUBLIC_API_GATEWAY_URL=https://api.example.com
NEXTAUTH_SECRET=replace-this-with-a-secure-random-value
NEXT_PUBLIC_NEXTAUTH_URL=http://localhost:3000
# Add any third-party keys used by the frontend (analytics, Sentry, etc.)
